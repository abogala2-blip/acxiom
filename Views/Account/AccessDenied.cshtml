@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Access Denied - AcxiomCRM</title>

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #030014;
            color: white;
            font-family: Arial, sans-serif;
        }

        .box {
            width: 420px;
            padding: 40px;
            border-radius: 22px;
            text-align: center;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.1);
        }

        a {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 20px;
            border-radius: 10px;
            background: #8b5cf6;
            color: white;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <div class="box">
        <h1>Access Denied</h1>
        <p>You do not have permission to access this page.</p>
        <a href="/Home/Index">Back to Dashboard</a>
    </div>
</body>
</html>
