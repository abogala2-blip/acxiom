@model IEnumerable<AcxiomCRM.Models.Opportunity>

@{
    ViewData["Title"] = "Opportunities";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Opportunities</h2>
            <p class="text-muted mb-0">
                Manage your sales opportunities
            </p>
        </div>

        <a href="/Opportunities/Create"
           class="btn btn-primary">
            + Create Opportunity
        </a>

    </div>


    <!-- SEARCH -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form method="get"
                  action="/Opportunities">

                <div class="row g-3">

                    <div class="col-md-5">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search opportunity or customer..." />

                    </div>


                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Stage
                        </label>

                        <select name="stage"
                                class="form-select">

                            <option value="">
                                All Stages
                            </option>

                            <option value="Qualification">
                                Qualification
                            </option>

                            <option value="Proposal">
                                Proposal
                            </option>

                            <option value="Negotiation">
                                Negotiation
                            </option>

                            <option value="Closed Won">
                                Closed Won
                            </option>

                            <option value="Closed Lost">
                                Closed Lost
                            </option>

                        </select>

                    </div>


                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            <option value="Open">
                                Open
                            </option>

                            <option value="Closed">
                                Closed
                            </option>

                        </select>

                    </div>


                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Search
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- TABLE -->

    <div class="card shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Opportunity</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Close Date</th>
                        <th>Status</th>
                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.OpportunityName
                                    </strong>
                                </td>

                                <td>
                                    @(item.Customer?.FullName ?? "N/A")
                                </td>

                                <td>
                                    ₹@item.Amount.ToString("N2")
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.Stage
                                    </span>
                                </td>

                                <td>
                                    @item.Probability%
                                </td>

                                <td>
                                    @item.ExpectedCloseDate.ToString("dd-MM-yyyy")
                                </td>

                                <td>

                                    @if (item.Status == "Open")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }

                                </td>


                                <td>

                                    <a href="/Opportunities/Details/@item.Id"
                                       class="crm-action crm-view btn-sm text-white">
                                        View
                                    </a>

                                    <a href="/Opportunities/Edit/@item.Id"
                                       class="crm-action crm-edit btn-sm">
                                        Edit
                                    </a>

                                    <a href="/Opportunities/Delete/@item.Id"
                                       class="crm-action crm-delete btn-sm">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center p-5">

                                <h5>No opportunities found</h5>

                                <a href="/Opportunities/Create"
                                   class="btn btn-primary mt-2">
                                    Create Opportunity
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

