@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="container mt-4">

    <h2 class="fw-bold">
        Edit Opportunity
    </h2>

    <p class="text-muted">
        Update opportunity information
    </p>


    <div class="card shadow-sm">

        <div class="card-body">

            <form method="post"
                  action="/Opportunities/Edit/@Model.Id">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <input type="hidden"
                       asp-for="LeadId" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">


                    <div class="col-md-6">

                        <label class="form-label">
                            Opportunity Name
                        </label>

                        <input asp-for="OpportunityName"
                               class="form-control" />

                        <span asp-validation-for="OpportunityName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Customer
                        </label>

                        <select asp-for="CustomerId"
                                class="form-select">

                            @if (ViewBag.Customers != null)
                            {
                                foreach (var customer in ViewBag.Customers)
                                {
                                    if (customer.Id == Model.CustomerId)
                                    {
                                        <option value="@customer.Id"
                                                selected>
                                            @customer.FullName
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@customer.Id">
                                            @customer.FullName
                                        </option>
                                    }
                                }
                            }

                        </select>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Amount
                        </label>

                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="Amount"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Stage
                        </label>

                        <select asp-for="Stage"
                                class="form-select">

                            <option value="Qualification">
                                Qualification
                            </option>

                            <option value="Proposal">
                                Proposal
                            </option>

                            <option value="Negotiation">
                                Negotiation
                            </option>

                            <option value="Closed Won">
                                Closed Won
                            </option>

                            <option value="Closed Lost">
                                Closed Lost
                            </option>

                        </select>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Probability (%)
                        </label>

                        <input asp-for="Probability"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control" />

                        <span asp-validation-for="Probability"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Expected Close Date
                        </label>

                        <input asp-for="ExpectedCloseDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="ExpectedCloseDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Open">
                                Open
                            </option>

                            <option value="Closed">
                                Closed
                            </option>

                        </select>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Assigned To
                        </label>

                        <input asp-for="AssignedTo"
                               class="form-control" />

                    </div>


                    <div class="col-12">

                        <label class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"></textarea>

                    </div>

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="crm-action crm-edit">
                        Save Changes
                    </button>

                    <a href="/Opportunities"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

