@using Microsoft.AspNetCore.Identity
@using AcxiomCRM.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isAdmin = User.IsInRole("Admin");
    var isManager = User.IsInRole("Manager");

    var displayName = User.Identity?.Name ?? "User";
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.FindByNameAsync(User.Identity!.Name!)
        : null;

    if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.FullName))
    {
        displayName = currentUser.FullName;
    }

    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "U"
        : displayName.Substring(0, 1).ToUpper();

    var roles = currentUser != null
        ? await UserManager.GetRolesAsync(currentUser)
        : new List<string>();

    var roleText = roles.Count > 0 ? roles[0] : "User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AcxiomCRM</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/crm-theme.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
<link rel="stylesheet" href="~/css/crm-dashboard.css" asp-append-version="true" />`r`n        <link rel="stylesheet" href="~/css/crm-ui-fix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/crm-ui.css?v=10" />
</head>

<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="crm-shell">

        <!-- SIDEBAR -->
        <aside class="crm-sidebar">

            <div class="crm-brand">
                <div class="crm-brand-icon">
                    A
                </div>

                <div class="crm-brand-text">
                    <div class="crm-brand-name">ACXIOM</div>
                    <div class="crm-brand-sub">CRM</div>
                </div>
            </div>

            <div class="crm-section-title">
                Workspace
            </div>

            <nav class="crm-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(currentController == "Home" ? "active" : "")">
                    <span class="crm-nav-icon">
                        <i class="bi bi-house-fill"></i>
                    </span>
                    Dashboard
                </a>

                <a asp-controller="Customers"
                   asp-action="Index"
                   class="@(currentController == "Customers" ? "active" : "")">
                    <span class="crm-nav-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    Customers
                </a>

                <a asp-controller="Leads"
                   asp-action="Index"
                   class="@(currentController == "Leads" ? "active" : "")">
                    <span class="crm-nav-icon">
                        <i class="bi bi-record-circle"></i>
                    </span>
                    Leads
                </a>

                <a asp-controller="Opportunities"
                   asp-action="Index"
                   class="@(currentController == "Opportunities" ? "active" : "")">
                    <span class="crm-nav-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </span>
                    Opportunities
                </a>

                <a asp-controller="FollowUps"
                   asp-action="Index"
                   class="@(currentController == "FollowUps" ? "active" : "")">
                    <span class="crm-nav-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </span>
                    Follow-Ups
                </a>

                <a asp-controller="Activities"
                   asp-action="Index"
                   class="@(currentController == "Activities" ? "active" : "")">
                    <span class="crm-nav-icon">
                        <i class="bi bi-list-check"></i>
                    </span>
                    Activities
                </a>

            </nav>

            <div class="crm-section-title">
                Analytics
            </div>

            <nav class="crm-nav">

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="@(currentController == "Reports" ? "active" : "")">
                    <span class="crm-nav-icon">
                        <i class="bi bi-pie-chart-fill"></i>
                    </span>
                    Reports
                </a>

                @if (isAdmin || isManager)
                {
                    <a asp-controller="Users"
                       asp-action="Index"
                       class="@(currentController == "Users" ? "active" : "")">
                        <span class="crm-nav-icon">
                            <i class="bi bi-person-gear"></i>
                        </span>
                        User Accounts
                    </a>
                }

                @if (isAdmin)
                {
                    <a asp-controller="Roles"
                       asp-action="Index"
                       class="@(currentController == "Roles" ? "active" : "")">
                        <span class="crm-nav-icon">
                            <i class="bi bi-shield-fill"></i>
                        </span>
                        Role Management
                    </a>
                }

                @if (isAdmin || isManager)
                {
                    <a asp-controller="AuditLogs"
                       asp-action="Index"
                       class="@(currentController == "AuditLogs" ? "active" : "")">
                        <span class="crm-nav-icon">
                            <i class="bi bi-clock-history"></i>
                        </span>
                        Audit Logs
                    </a>
                }

            </nav>

        </aside>

        <!-- MAIN -->
        <main class="crm-main">

            <div class="crm-topbar">

                <div class="crm-workspace-title">
                    Acxiom CRM workspace
                </div>

                <div class="crm-top-actions">

                    <!-- APPEARANCE -->
                    <button type="button"
                            id="crmThemeButton"
                            class="crm-theme-button"
                            onclick="toggleThemePanel()"
                            title="Appearance">
                        <i class="bi bi-palette-fill"></i>
                    </button>

                    <div id="crmThemePanel" class="crm-theme-panel">

                        <div class="crm-theme-title">
                            APPEARANCE
                        </div>

                        <div class="crm-theme-options">

                            <button type="button"
                                    class="crm-theme-option theme-purple"
                                    data-theme="default"
                                    onclick="setCrmTheme('default')"
                                    title="Purple"></button>

                            <button type="button"
                                    class="crm-theme-option theme-emerald"
                                    data-theme="emerald"
                                    onclick="setCrmTheme('emerald')"
                                    title="Emerald"></button>

                            <button type="button"
                                    class="crm-theme-option theme-sunset"
                                    data-theme="sunset"
                                    onclick="setCrmTheme('sunset')"
                                    title="Sunset"></button>

                            <button type="button"
                                    class="crm-theme-option theme-light"
                                    data-theme="light"
                                    onclick="setCrmTheme('light')"
                                    title="Light"></button>

                        </div>

                    </div>

                    <!-- USER -->
                    <div class="crm-top-user">

                        <button type="button"
                                class="crm-user-trigger"
                                onclick="toggleUserMenu()">

                            <div class="crm-avatar">
                                @initial
                            </div>

                            <div class="crm-user-info">

                                <div class="crm-user-name">
                                    @displayName
                                </div>

                                <div class="crm-user-role">
                                    @roleText
                                </div>

                            </div>

                            <span class="crm-user-arrow">
                                <i class="bi bi-chevron-down"></i>
                            </span>

                        </button>

                        <div id="crmUserMenu"
                             class="crm-user-menu">

                            <div class="crm-user-menu-header">
                                <strong>@displayName</strong>
                                <span>@roleText</span>
                            </div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="crm-menu-button logout">

                                    <i class="bi bi-box-arrow-right"></i>

                                    Logout

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

            @RenderBody()

            <div class="crm-footer">
                AcxiomCRM • Customer Relationship Management
            </div>

        </main>

    </div>
}
else
{
    @RenderBody()
}

<script src="~/js/crm-theme.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>





