@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container mt-4">

    <h2>Delete Activity</h2>

    <div class="alert alert-danger">
        Are you sure you want to delete this activity?
    </div>

    <div class="card mb-3">

        <div class="card-body">

            <h5>@Model.Subject</h5>

            <p>Type: @Model.ActivityType</p>

            <p>
                Date:
                @Model.ActivityDate.ToString("dd-MM-yyyy hh:mm tt")
            </p>

            <p>Status: @Model.Status</p>

        </div>

    </div>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="crm-action crm-delete">
            Yes, Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
