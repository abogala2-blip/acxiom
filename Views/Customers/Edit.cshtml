@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="crm-page-header">

    <div>
        <div class="eyebrow">CUSTOMER MANAGEMENT</div>
        <h1>Edit Customer</h1>
        <p>Update customer information.</p>
    </div>

</div>

<div class="crm-card crm-form-card">

    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />

        <input asp-for="CreatedAt"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="crm-alert danger">
        </div>

        <div class="crm-form-grid">

            <div class="crm-field">
                <label asp-for="FullName">
                    Full Name
                </label>

                <input asp-for="FullName"
                       class="crm-input" />
            </div>

            <div class="crm-field">
                <label asp-for="Email">
                    Email
                </label>

                <input asp-for="Email"
                       class="crm-input" />
            </div>

            <div class="crm-field">
                <label asp-for="Phone">
                    Phone
                </label>

                <input asp-for="Phone"
                       class="crm-input" />
            </div>

            <div class="crm-field">
                <label asp-for="Company">
                    Company
                </label>

                <input asp-for="Company"
                       class="crm-input" />
            </div>

            <div class="crm-field">
                <label asp-for="City">
                    City
                </label>

                <input asp-for="City"
                       class="crm-input" />
            </div>

            <div class="crm-field">
                <label asp-for="Status">
                    Status
                </label>

                <select asp-for="Status"
                        class="crm-input">

                    <option>Active</option>
                    <option>Inactive</option>

                </select>
            </div>

            @if (User.IsInRole("Admin") ||
                 User.IsInRole("Manager"))
            {
                <div class="crm-field">

                    <label asp-for="AssignedTo">
                        Assigned To
                    </label>

                    <input asp-for="AssignedTo"
                           class="crm-input"
                           placeholder="sales@acxiomcrm.com" />

                </div>
            }

        </div>

        <div class="crm-form-actions">

            <button class="crm-btn primary"
                    type="submit">
                Save Changes
            </button>

            <a asp-action="Index"
               class="crm-btn ghost">
                Cancel
            </a>

        </div>

    </form>

</div>
