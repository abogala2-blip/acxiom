@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Follow-Up Details";
}

<div class="container mt-4">

    <h2>Follow-Up Details</h2>

    <div class="card">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Follow-Up Date</dt>
                <dd class="col-sm-9">
                    @Model.FollowUpDate.ToString("dd-MM-yyyy hh:mm tt")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Priority</dt>
                <dd class="col-sm-9">@Model.Priority</dd>

                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">
                    @(Model.Customer?.FullName ?? "-")
                </dd>

                <dt class="col-sm-3">Lead</dt>
                <dd class="col-sm-9">
                    @(Model.Lead?.LeadName ?? "-")
                </dd>

                <dt class="col-sm-3">Opportunity</dt>
                <dd class="col-sm-9">
                    @(Model.Opportunity?.OpportunityName ?? "-")
                </dd>

                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">
                    @(Model.Notes ?? "-")
                </dd>

            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="crm-action crm-edit">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>
