@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Add Lead";
}

<div>

    <div class="crm-topbar">

        <div>
            <h1 style="margin:0;font-family:'Outfit';font-size:42px;">
                Add Lead
            </h1>

            <div class="crm-muted" style="margin-top:7px;">
                Add a new prospect to your CRM.
            </div>
        </div>

        <a asp-controller="Leads"
           asp-action="Index"
           class="crm-btn crm-btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to Leads

        </a>

    </div>

    <div class="crm-card crm-form-card">

        <form asp-controller="Leads"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="crm-validation"
                 style="margin-bottom:20px;">
            </div>

            <div class="crm-form-grid">

                <div class="crm-field">

                    <label asp-for="LeadName">
                        Lead Name
                        <span class="required">*</span>
                    </label>

                    <input asp-for="LeadName"
                           class="crm-input"
                           placeholder="Enter lead name" />

                    <span asp-validation-for="LeadName"
                          class="crm-validation">
                    </span>

                </div>

                <div class="crm-field">

                    <label asp-for="Email">
                        Email
                        <span class="required">*</span>
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="crm-input"
                           placeholder="lead@example.com" />

                    <span asp-validation-for="Email"
                          class="crm-validation">
                    </span>

                </div>

                <div class="crm-field">

                    <label asp-for="Phone">
                        Phone
                    </label>

                    <input asp-for="Phone"
                           class="crm-input"
                           placeholder="Enter phone number" />

                </div>

                <div class="crm-field">

                    <label asp-for="CompanyName">
                        Company
                    </label>

                    <input asp-for="CompanyName"
                           class="crm-input"
                           placeholder="Enter company name" />

                </div>

                <div class="crm-field">

                    <label asp-for="Source">
                        Source
                        <span class="required">*</span>
                    </label>

                    <select asp-for="Source"
                            class="crm-select">

                        <option value="Website">Website</option>
                        <option value="Referral">Referral</option>
                        <option value="Social Media">Social Media</option>
                        <option value="Advertisement">Advertisement</option>
                        <option value="Email">Email</option>
                        <option value="Phone">Phone</option>
                        <option value="Other">Other</option>

                    </select>

                </div>

                <div class="crm-field">

                    <label asp-for="Status">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="crm-select">

                        <option value="New">New</option>
                        <option value="Contacted">Contacted</option>
                        <option value="Qualified">Qualified</option>
                        <option value="Converted">Converted</option>
                        <option value="Lost">Lost</option>

                    </select>

                </div>

                <div class="crm-field">

                    <label asp-for="ExpectedValue">
                        Expected Value
                    </label>

                    <input asp-for="ExpectedValue"
                           type="number"
                           step="0.01"
                           class="crm-input"
                           placeholder="0.00" />

                    <span asp-validation-for="ExpectedValue"
                          class="crm-validation">
                    </span>

                </div>

                <div class="crm-field">

                    <label>
                        Assigned To
                    </label>

                    <input class="crm-input"
                           value="@User.Identity?.Name"
                           readonly />

                </div>

                <div class="crm-field full">

                    <label asp-for="Notes">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="crm-textarea"
                              placeholder="Add notes about this lead..."></textarea>

                </div>

            </div>

            <div style="
                display:flex;
                gap:10px;
                margin-top:25px;
                flex-wrap:wrap;
            ">

                <button type="submit"
                        class="crm-btn crm-btn-primary">

                    <i class="bi bi-check-lg"></i>
                    Save Lead

                </button>

                <a asp-controller="Leads"
                   asp-action="Index"
                   class="crm-btn crm-btn-secondary">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
