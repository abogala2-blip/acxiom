@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Edit Lead";
}

<div>

    <div class="crm-topbar">

        <div>
            <h1 style="margin:0;font-family:'Outfit';font-size:42px;">
                Edit Lead
            </h1>

            <div class="crm-muted">
                Update lead information.
            </div>
        </div>

        <a asp-action="Index"
           class="crm-btn crm-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

    <div class="crm-card crm-form-card">

        <form asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="crm-validation">
            </div>

            <div class="crm-form-grid">

                <div class="crm-field">
                    <label asp-for="LeadName">Lead Name *</label>
                    <input asp-for="LeadName" class="crm-input" />
                    <span asp-validation-for="LeadName"
                          class="crm-validation"></span>
                </div>

                <div class="crm-field">
                    <label asp-for="Email">Email *</label>
                    <input asp-for="Email"
                           type="email"
                           class="crm-input" />
                    <span asp-validation-for="Email"
                          class="crm-validation"></span>
                </div>

                <div class="crm-field">
                    <label asp-for="Phone">Phone</label>
                    <input asp-for="Phone"
                           class="crm-input" />
                </div>

                <div class="crm-field">
                    <label asp-for="CompanyName">Company</label>
                    <input asp-for="CompanyName"
                           class="crm-input" />
                </div>

                <div class="crm-field">
                    <label asp-for="Source">Source</label>
                    <select asp-for="Source"
                            class="crm-select">
                        <option>Website</option>
                        <option>Referral</option>
                        <option>Social Media</option>
                        <option>Advertisement</option>
                        <option>Email</option>
                        <option>Phone</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="crm-field">
                    <label asp-for="Status">Status</label>
                    <select asp-for="Status"
                            class="crm-select">
                        <option>New</option>
                        <option>Contacted</option>
                        <option>Qualified</option>
                        <option>Converted</option>
                        <option>Lost</option>
                    </select>
                </div>

                <div class="crm-field">
                    <label asp-for="ExpectedValue">
                        Expected Value
                    </label>
                    <input asp-for="ExpectedValue"
                           type="number"
                           step="0.01"
                           class="crm-input" />
                </div>

                <div class="crm-field full">
                    <label asp-for="Notes">Notes</label>
                    <textarea asp-for="Notes"
                              class="crm-textarea"></textarea>
                </div>

            </div>

            <div style="margin-top:25px;display:flex;gap:10px;">

                <button type="submit"
                        class="crm-btn crm-btn-primary">

                    <i class="bi bi-save"></i>
                    Save Changes

                </button>

                <a asp-action="Index"
                   class="crm-btn crm-btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
