@model List<AcxiomCRM.Models.ReportRow>

@{
    ViewData["Title"] = "Reports";

    var reportType = ViewBag.ReportType as string ?? "Customers";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var sort = ViewBag.Sort as string ?? "date_desc";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
}

<div class="container py-4">

    <h1>Reports</h1>

    <p class="text-muted">
        Customer, Lead, Follow-Up, Opportunity,
        Pipeline, Sales, User Activity and Audit Reports.
    </p>

    <form method="get" class="row g-2 mb-4">

        <div class="col-md-3">
            <label class="form-label">Report</label>

            <select name="reportType" class="form-select">
                <option value="Customers" selected="@(reportType == "Customers")">
                    Customer Report
                </option>
                <option value="Leads" selected="@(reportType == "Leads")">
                    Lead Report
                </option>
                <option value="FollowUps" selected="@(reportType == "FollowUps")">
                    Follow-Up Report
                </option>
                <option value="Opportunities" selected="@(reportType == "Opportunities")">
                    Opportunity Report
                </option>
                <option value="Pipeline" selected="@(reportType == "Pipeline")">
                    Pipeline Report
                </option>
                <option value="SalesConversion" selected="@(reportType == "SalesConversion")">
                    Sales / Conversion Report
                </option>
                <option value="UserActivity" selected="@(reportType == "UserActivity")">
                    User Activity Report
                </option>
                <option value="Audit" selected="@(reportType == "Audit")">
                    Audit Report
                </option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Search</label>
            <input name="search"
                   value="@search"
                   class="form-control"
                   placeholder="Search..." />
        </div>

        <div class="col-md-2">
            <label class="form-label">Status / Action</label>
            <input name="status"
                   value="@status"
                   class="form-control"
                   placeholder="Optional" />
        </div>

        <div class="col-md-2">
            <label class="form-label">From</label>
            <input name="fromDate"
                   value="@ViewBag.FromDate"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">To</label>
            <input name="toDate"
                   value="@ViewBag.ToDate"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-3 mt-3">
            <label class="form-label">Sort By</label>

            <select name="sort" class="form-select">

                <option value="date_desc"
                        selected="@(sort == "date_desc")">
                    Newest First
                </option>

                <option value="date_asc"
                        selected="@(sort == "date_asc")">
                    Oldest First
                </option>

                <option value="name_asc"
                        selected="@(sort == "name_asc")">
                    Name A-Z
                </option>

                <option value="name_desc"
                        selected="@(sort == "name_desc")">
                    Name Z-A
                </option>

                <option value="amount_asc"
                        selected="@(sort == "amount_asc")">
                    Amount Low-High
                </option>

                <option value="amount_desc"
                        selected="@(sort == "amount_desc")">
                    Amount High-Low
                </option>

            </select>
        </div>

        <div class="col-md-2 mt-3">
            <label class="form-label">Page Size</label>

            <select name="pageSize" class="form-select">

                <option value="10"
                        selected="@(pageSize == 10)">
                    10
                </option>

                <option value="25"
                        selected="@(pageSize == 25)">
                    25
                </option>

                <option value="50"
                        selected="@(pageSize == 50)">
                    50
                </option>

            </select>
        </div>

        <div class="col-12 mt-3">

            <button class="btn btn-primary">
                Generate Report
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>


    <div class="mb-2 text-muted">
        Showing @Model.Count of @totalRecords records
    </div>


    @if (reportType == "Customers")
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Company</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th>Created</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td>@r.Email</td>
                            <td>@r.RelatedName</td>
                            <td>@r.Status</td>
                            <td>@r.Owner</td>
                            <td>@r.CreatedDate.ToString("dd-MM-yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    else if (reportType == "Leads")
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Lead</th>
                        <th>Email</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th>Expected Value</th>
                        <th>Created</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td>@r.Email</td>
                            <td>@r.Source</td>
                            <td>@r.Status</td>
                            <td>@r.Owner</td>
                            <td>?@r.Amount.ToString("N2")</td>
                            <td>@r.CreatedDate.ToString("dd-MM-yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    else if (reportType == "FollowUps")
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Subject</th>
                        <th>Related To</th>
                        <th>Status</th>
                        <th>Follow-Up Date</th>
                        <th>Created</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td>@r.RelatedName</td>
                            <td>@r.Status</td>
                            <td>@r.FollowUpDate?.ToString("dd-MM-yyyy HH:mm")</td>
                            <td>@r.CreatedDate.ToString("dd-MM-yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    else if (reportType == "Opportunities")
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Opportunity</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Expected Close</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td>@r.RelatedName</td>
                            <td>@r.Stage</td>
                            <td>@r.Status</td>
                            <td>?@r.Amount.ToString("N2")</td>
                            <td>@r.Probability%</td>
                            <td>@r.ExpectedCloseDate?.ToString("dd-MM-yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    else if (reportType == "Pipeline")
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Stage</th>
                        <th>Pipeline Amount</th>
                        <th>Average Probability</th>
                        <th>Weighted Pipeline</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td>?@r.Amount.ToString("N2")</td>
                            <td>@r.Probability%</td>
                            <td>?@r.WeightedAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    else if (reportType == "SalesConversion")
    {
        <div class="row g-3">

            @foreach (var r in Model)
            {
                <div class="col-md-4">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <h5>@r.Name</h5>

                            <h2>
                                @if (r.Name.Contains("Rate"))
                                {
                                    @r.Amount.ToString("N2")<text>%</text>
                                }
                                else
                                {
                                    @r.Amount.ToString("N0")
                                }
                            </h2>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    else if (reportType == "UserActivity")
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>User</th>
                        <th>Activity Count</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td>@r.Amount</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    else if (reportType == "Audit")
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Entity ID</th>
                        <th>Details</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Timestamp.ToString("dd-MM-yyyy HH:mm")</td>
                            <td>@r.Name</td>
                            <td>@r.Action</td>
                            <td>@r.EntityName</td>
                            <td>@r.EntityId</td>
                            <td>@r.Details</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }


    @if (totalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination">

                <li class="page-item @(page == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-reportType="@reportType"
                       asp-route-search="@search"
                       asp-route-status="@status"
                       asp-route-fromDate="@ViewBag.FromDate"
                       asp-route-toDate="@ViewBag.ToDate"
                       asp-route-sort="@sort"
                       asp-route-page="@(page - 1)"
                       asp-route-pageSize="@pageSize">
                        Previous
                    </a>

                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-reportType="@reportType"
                           asp-route-search="@search"
                           asp-route-status="@status"
                           asp-route-fromDate="@ViewBag.FromDate"
                           asp-route-toDate="@ViewBag.ToDate"
                           asp-route-sort="@sort"
                           asp-route-page="@i"
                           asp-route-pageSize="@pageSize">
                            @i
                        </a>

                    </li>
                }

                <li class="page-item @(page == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-reportType="@reportType"
                       asp-route-search="@search"
                       asp-route-status="@status"
                       asp-route-fromDate="@ViewBag.FromDate"
                       asp-route-toDate="@ViewBag.ToDate"
                       asp-route-sort="@sort"
                       asp-route-page="@(page + 1)"
                       asp-route-pageSize="@pageSize">
                        Next
                    </a>

                </li>

            </ul>

        </nav>
    }

</div>
