@model IEnumerable<AcxiomCRM.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Audit Logs</h2>
            <p class="text-muted">
                Track create, update and delete activities.
            </p>
        </div>

    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-4">

        <div class="col-md-6">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search entity or user..." />
        </div>

        <div class="col-md-3">

            <select name="action" class="form-select">

                <option value="">All Actions</option>

                @if (ViewBag.Action == "Create")
                {
                    <option value="Create" selected>Create</option>
                }
                else
                {
                    <option value="Create">Create</option>
                }

                @if (ViewBag.Action == "Update")
                {
                    <option value="Update" selected>Update</option>
                }
                else
                {
                    <option value="Update">Update</option>
                }

                @if (ViewBag.Action == "Delete")
                {
                    <option value="Delete" selected>Delete</option>
                }
                else
                {
                    <option value="Delete">Delete</option>
                }

            </select>

        </div>

        <div class="col-md-3">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-striped table-hover mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Entity ID</th>
                            <th>Details</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var log in Model)
                            {
                                <tr>

                                    <td>
                                        @log.Timestamp.ToLocalTime()
                                    </td>

                                    <td>
                                        @log.UserName
                                    </td>

                                    <td>

                                        @if (log.Action == "Create")
                                        {
                                            <span class="badge bg-success">
                                                Create
                                            </span>
                                        }
                                        else if (log.Action == "Update")
                                        {
                                            <span class="badge bg-primary">
                                                Update
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Delete
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @log.EntityName
                                    </td>

                                    <td>
                                        @log.EntityId
                                    </td>

                                    <td>
                                        @log.Details
                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@log.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center p-4">
                                    No audit logs found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
